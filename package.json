{
  "name": "sisfaune-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4501",
    "db:dev:push": "dotenv -e .env.development.local -- prisma db push",
    "db:dev:generate": "dotenv -e .env.development.local -- prisma generate",
    "db:dev:reset": "dotenv -e .env.development.local -- prisma migrate reset --skip-seed",
    "db:dev:seed": "dotenv -e .env.development.local -- prisma db seed",
    "db:dev:test-seed": "npm run db:dev:reset && npm run db:dev:push && npm run db:dev:seed",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "standard": "standard --fix",
    "test": "vitest",
    "email-dev": "email dev --dir src/lib/email --port 4502"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.8.0",
    "@choc-ui/chakra-autocomplete": "^6.1.0",
    "@emotion/react": "^11.13.3",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "5.18.0",
    "@react-email/components": "0.0.38",
    "@react-hooks-library/core": "^0.6.2",
    "@rehookify/datepicker": "^6.6.8",
    "@uidotdev/usehooks": "^2.4.1",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "downshift": "^9.0.9",
    "framer-motion": "^11.3.30",
    "generate-password": "^1.7.1",
    "lodash.orderby": "^4.6.0",
    "luxon": "^3.5.0",
    "next": "15.0.2",
    "next-auth": "^5.0.0-beta.25",
    "next-safe-action": "^7.10.7",
    "next-themes": "^0.3.0",
    "nuqs": "^2.3.0",
    "prisma": "^5.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^5.3.0",
    "react-static-google-map": "^0.9.0",
    "server-only": "^0.0.1",
    "swr": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.2",
    "react-email": "4.0.11",
    "standard": "^17.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "standard": {
    "ignore": [
      "*.jsx"
    ]
  },
  "prisma": {
    "seed": "dotenv -e .env.development.local -- node src/lib/data/seed/index.js"
  }
}
