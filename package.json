{
  "name": "sisfaune-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4501",
    "email:dev": "email dev --dir src/lib/email --port 4502",
    "db:dev:push": "dotenv -e .env.development.local -- prisma db push",
    "db:dev:generate": "dotenv -e .env.development.local -- prisma generate",
    "db:dev:migration-create": "dotenv -e .env.development.local -- prisma migrate dev --create-only",
    "db:dev:migrate-up": "dotenv -e .env.development.local -- prisma migrate dev",
    "db:dev:reset": "dotenv -e .env.development.local -- prisma migrate reset --skip-seed",
    "db:dev:seed": "dotenv -e .env.development.local -- prisma db seed",
    "db:dev:test-seed": "npm run db:dev:reset && npm run db:dev:push && npm run db:dev:seed",
    "db:test:push": "dotenv -e .env.test.local -- prisma db push",
    "db:test:reset": "dotenv -e .env.test.local -- prisma migrate reset --skip-seed",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "standard": "standard --fix",
    "test": "dotenv -e .env.test.local -- vitest",
    "postinstall": "prisma generate",
    "postbuild": "npx prisma migrate deploy"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.26.0",
    "@dnd-kit/react": "^0.3.2",
    "@emotion/react": "^11.13.3",
    "@fast-csv/format": "^5.0.2",
    "@hookform/resolvers": "^3.9.1",
    "@netlify/blobs": "^10.5.0",
    "@netlify/functions": "^5.1.0",
    "@prisma/client": "^5.18.0",
    "@react-email/components": "0.0.38",
    "@react-hook/debounce": "^4.0.0",
    "@react-hooks-library/core": "^0.6.2",
    "@react-pdf/renderer": "^4.3.0",
    "@rehookify/datepicker": "^6.6.8",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-query-devtools": "^5.76.1",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/turf": "^7.2.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/blob": "^2.3.3",
    "@vis.gl/react-google-maps": "^1.5.5",
    "aspnet-identity-pw": "^1.0.2",
    "basic-ftp": "^5.0.5",
    "bcrypt": "^6.0.0",
    "daynight": "^4.0.1",
