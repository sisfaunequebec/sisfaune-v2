    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^8",
    "eslint-config-next": "15.0.2",
    "netlify-cli": "^23.13.3",
    "prisma": "^5.18.0",
    "react-email": "4.0.11",
    "standard": "^17.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite-jsconfig-paths": "^2.0.1",
    "vitest": "^2.1.8"
  },
  "standard": {
    "ignore": [
      "*.jsx"
    ]
  },
