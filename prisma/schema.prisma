
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL") // uses connection pooling
}

model User {
  @@map("auth_utilisateur")
  id            String          @id @default(cuid())
  name          String? @map(name: "nom_complet")
  email         String          @unique @map(name: "adresse_courriel")
  emailVerified DateTime? @map(name: "meta_date_verification_courriel")
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  // Authenticator Authenticator[]
 
  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")

  eventCreated Event[] @relation("EventCreator")
  eventSubmitted Event[] @relation("EventSubmitter")
}
 
model Account {
  @@map("auth_compte")
  userId            String  @map(name: "id_utilisateur")
  type              String
  provider          String @map(name: "id_fournisseur")
  providerAccountId String  @map(name: "id_compte_fournisseur")
  refresh_token     String? @map(name: "jeton_renouvellement")
  access_token      String? @map(name: "jeton_acces")
  expires_at        Int? @map(name: "meta_date_expiration")
  token_type        String? @map(name: "type_jeton")
  scope             String?
  id_token          String? @map(name: "id_jeton")
  session_state     String? @map(name: "etat_Session")
 
  createdAt DateTime @default(now())  @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  @@map("auth_session")
  sessionToken String   @unique @map(name: "jeton_session")
  userId       String @map(name: "id_utilisateur")
  expires      DateTime @map(name: "meta_date_expiration")
  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
 
model VerificationToken {
  @@map("auth_token")
  identifier String @unique @map(name: "identifiant")
  token      String @unique @map(name: "jeton")
  expires    DateTime @map(name: "meta_date_expiration")
 
  @@id([identifier, token])
}

model LutEventType {
  @@map("lut_evenement_type")
  id Int @id @db.SmallInt
  name String @map(name: "nom")

  event Event[]
}

model LutReportOrigin {
  @@map("lut_signalement_provenance")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  isActive Boolean @default(true)

  event Event[]
}

model LutEventProgram {
  @@map("lut_evenement_programme")
  id Int @id @db.SmallInt
  code String
  name String @map(name: "nom")
  isActive Boolean @default(true)

  event Event[]
}

model LutEventStatus {
  @@map("lut_evenement_statut")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  mapaqCode String @map(name: "code_mapaq")

  event Event[]
}

model LutHabitatType {
  @@map("lut_habitat_type")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  group String @map(name: "groupe")

  event Event[]
}

model LutLabShippingMethod {
  @@map("lut_methode_expedition")
  id Int @id @db.SmallInt
  name String @map(name: "nom")

  event Event[]
}

model LutAnimalFamily {
  @@map("lut_animal_famille")
  id Int @id @db.SmallInt
  name String @map(name: "nom")

  specie LutAnimalSpecie[]
}

model LutAnimalSpecie {
  @@map("lut_animal_espece")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  group String @map(name: "group")
  binome String @map(name: "binome")

  familyId Int @map(name: "id_famille")
  family LutAnimalFamily @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  eventAffectedSpecie1 Event[] @relation("EventAffectedSpecie1")
  eventAffectedSpecie2 Event[] @relation("EventAffectedSpecie2")
  eventAffectedSpecie3 Event[] @relation("EventAffectedSpecie3")
  eventAffectedSpecie4 Event[] @relation("EventAffectedSpecie4")
  eventAffectedSpecie5 Event[] @relation("EventAffectedSpecie5")
}

model LutLaboratory {
  @@map("lut_laboratoire")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  isActive Boolean @default(true)

  labEvent LabEvent[] 
}

model Collaborator {
  @@map("data_intervenant")
  id Int @id @db.SmallInt
  name String @map(name: "nom")
  isActive Boolean @default(true)

  event Event[]
}

