model LutResultCodeValue {
  @@map("lut_resultat_code_valeur")

  id Int @db.SmallInt @id @default(autoincrement())
  analysisId Int @db.SmallInt @map(name: "id_analyse")
  code String @map(name: "code")
  description String @map(name: "description")
  isActive Boolean @default(true) @map(name: "actif")
  displayOrder Int @db.SmallInt @default(1) @map(name: "ordre_affichage")

  analysis LutAnalysis @relation(fields: [analysisId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model LutAnalysis {
  @@map("lut_analyse")

  id Int @id @default(autoincrement())
  name String @map(name: "nom")
  code String? @map(name: "code")
  isActive Boolean @default(true) @map(name: "actif")
  precision Int? @db.SmallInt @map(name: "precision")
  unit String? @map(name: "unite")
  lowerLimit Decimal? @db.Decimal(18, 5) @map(name: "borne_inf")
  upperLimit Decimal? @db.Decimal(18, 5) @map(name: "borne_sup")
  defaultValue String? @map(name: "valeur_defaut")
  isShared Boolean @default(false) @map(name: "partage")

  analysisGroupId Int @db.SmallInt @map(name: "id_analyse_groupe")
  resultTypeId Int @db.SmallInt @map(name: "id_resultat_type")

  analysisGroup LutAnalysisGroup @relation(fields: [analysisGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultType LutResultType @relation(fields: [resultTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  results Result[]

  codeValues LutResultCodeValue[]
}

