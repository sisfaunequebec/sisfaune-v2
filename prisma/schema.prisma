  isActive Boolean @default(true) @map(name: "actif")

  analysisSectorId Int @db.SmallInt @map(name: "id_analyse_secteur")

  analysisSector LutAnalysisSector @relation(fields: [analysisSectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
