
generator client {
  provider = "prisma-client-js"
  extensions = [postgis(version: "3.5")]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL") // uses connection pooling
}

model User {
  @@map("auth_utilisateur")

  id            String          @id @default(cuid())
  name          String? @map(name: "nom_complet")
  email         String          @unique @map(name: "adresse_courriel")
  emailVerified DateTime? @map(name: "meta_date_verification_courriel")
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  // Authenticator Authenticator[]
 
  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")

  eventsCreated Event[] @relation("EventCreator")
  eventsSubmitted Event[] @relation("EventSubmitter")
}
 
model Account {
  @@map("auth_compte")

  userId            String  @map(name: "id_utilisateur")
  type              String
  provider          String @map(name: "id_fournisseur")
  providerAccountId String  @map(name: "id_compte_fournisseur")
  refresh_token     String? @map(name: "jeton_renouvellement")
  access_token      String? @map(name: "jeton_acces")
  expires_at        Int? @map(name: "meta_date_expiration")
  token_type        String? @map(name: "type_jeton")
  scope             String?
  id_token          String? @map(name: "id_jeton")
  session_state     String? @map(name: "etat_session")

  isActive Boolean @map(name: "actif") @default(true)
 
  createdAt DateTime @default(now())  @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  @@map("auth_session")

  sessionToken String   @unique @map(name: "jeton_session")
  userId       String @map(name: "id_utilisateur")
  expires      DateTime @map(name: "meta_date_expiration")
  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
 
model VerificationToken {
  @@map("auth_token")

  identifier String @unique @map(name: "identifiant")
  token      String @unique @map(name: "jeton")
  expires    DateTime @map(name: "meta_date_expiration")
 
  @@id([identifier, token])
}

model LutAnalysisSector {
  @@map("lut_analyse_secteur")

  id Int @db.SmallInt @id
  name String @map(name: "nom")

  AnalysisGroup LutAnalysisGroup[] 
}
model LutAnalysisGroup {
  @@map("lut_analyse_groupe")

  id Int @db.SmallInt @id
  name String @map(name: "nom")
  code String? @map(name: "code")
  isActive Boolean @default(true) @map(name: "actif")

  analysisSectorId Int @db.SmallInt @map(name: "id_analyse_secteur")

  analysisSector LutAnalysisSector @relation(fields: [analysisSectorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  Analysis LutAnalysis[]
}

model LutResultType {
  @@map("lut_resultat_type")

  id Int @db.SmallInt @id
  name String @map(name: "nom")

  analysis LutAnalysis[]
}

model LutAnalysis {
  @@map("lut_analyse")

  id Int @id
  name String @map(name: "nom")
  code String? @map(name: "code")
  isActive Boolean @default(true) @map(name: "actif")
  precision Int? @db.SmallInt @map(name: "precision")
  unite String? @map(name: "unite")
  min Decimal? @db.Decimal(18, 5) @map(name: "borne_inf")
  max Decimal? @db.Decimal(18, 5) @map(name: "borne_sup")
  defaultValue String? @map(name: "valeur_defaut")
  isShared Boolean @default(false) @map(name: "partage")

  analysisGroupId Int @db.SmallInt @map(name: "id_analyse_groupe")
  resultTypeId Int @db.SmallInt @map(name: "id_resultat_type")

  analysisGroup LutAnalysisGroup @relation(fields: [analysisGroupId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultType LutResultType @relation(fields: [resultTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  results Result[]
}

