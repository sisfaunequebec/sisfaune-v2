  unitId Int @db.SmallInt @map(name: "id_unite")

  type LutAnimalMeasureType @relation(fields: [measureTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit LutMeasureUnit @relation(fields: [unitId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Relations
  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

