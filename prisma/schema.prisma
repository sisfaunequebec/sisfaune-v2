  @@map("data_intervenant")

  id Int @id @db.SmallInt @default(autoincrement())
  name String @map(name: "nom")
  isActive Boolean @default(true) @map(name: "actif")

 // Relations
  events Event[]
}

model Discoverer {
  @@map("data_decouvreur")

  eventId Int @id @map(name: "id_evenement")

  greeting String? @map(name: "salutation")
  lastName String? @map(name: "nom")
  firstName String? @map(name: "prenom")

  email String? @map(name: "courriel")
  telephone String? @map(name: "telephone")

  streetNumber String? @map(name: "no_civique")
  street String? @map(name: "route")
  apt String? @map(name: "appartement")

  localityId Int? @map(name: "id_muni")
  localityName String? @map(name: "municipalite")
  province String? @map(name: "province")
  postalCode String? @map(name: "code_postal")

  legacyAddressId Int? @map(name: "id_adresse_egacy")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locality LutLocality? @relation(fields: [localityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // events Event[]
}

model Result {
  @@map("data_resultat")

  id Int @id @default(autoincrement())
  specimenId Int @map(name: "id_specimen")
  analysisId Int @map(name: "id_analyse")
  value String? @map(name: "valeur")

  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  analysis LutAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([specimenId, analysisId])
}
model Specimen {
  @@map("data_specimen")

  id Int @id @default(autoincrement())
  eventId Int @map(name: "id_evenement")

  // n Int @db.SmallInt @map(name: "n") @default(0)
  sequenceId Int @db.SmallInt	@map(name: "id_sequentiel") @default(0)
  specimenNumber String? @map(name: "numero_specimen")
  
  silabIdentificationNumber String? @map(name: "numero_identification_silab")
  cqsasNumber String? @map(name: "numero_cqsas")
  terrainIdentificationNumber String? @map(name: "numero_identification_terrain")
  pathologyNumber String? @map(name: "numero_pathologie")
  huntingPermitNumber String? @map(name: "numero_permis_chasse")
  sefaqNumber String? @map(name: "numero_sefaq")

  identifier String? @map(name: "identifie_par") // TODO : TOUJOURS VIDE
  identificationMarks String? @map(name: "marques_identification") 

  specieId Int? @db.SmallInt @map(name: "id_animal_espece")
  ageId Int? @db.SmallInt @map(name: "id_animal_age") // @default(0) // 0 requis => valeur CSSSF
  sexId Int? @db.SmallInt @map(name: "id_animal_sexe")

  weight Decimal? @db.Decimal(10, 3) @map(name: "poids")
  weightUnitId Int? @db.SmallInt @map(name: "id_poids_unite")

  // Euthanasia - merged from legacy table "euthanasie"
  euthanasiaMethodId Int? @map(name: "id_euthanasie_methode")
  euthanasiaMethod LutEuthanasiaMethod? @relation(fields: [euthanasiaMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  euthanizedAt DateTime? @db.Date @map(name: "date_euthanasie")
  productAmount Decimal? @db.Decimal(18, 2) @map(name: "qtee_produit")
  bottleNumber String? @map(name: "no_bouteille")

  euthanasiaOrganisationId Int? @map(name: "id_euthanasie_organisme")
  euthanasiaOrganisation LutEuthanasiaOrganisation? @relation(fields: [euthanasiaOrganisationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  discoveryStateId Int? @db.SmallInt @map(name: "id_etat_decouverte")
  deathCauseId Int @db.SmallInt @map(name: "id_cause_mort") @default(0) // 0 requis => valeur CSSSF
  preservationMethodId Int @db.SmallInt @map(name: "id_methode_conservation") @default(0) // 0 requis => valeur CSSSF

  notes String? @map(name: "remarques")
  keywords String? @map(name: "motcles")

  createdAt DateTime @default(now()) @map("meta_date_creation")
  createdBy String? @map("meta_creation_par") 

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  specie LutAnimalSpecie? @relation(fields: [specieId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  age LutAnimalAge? @relation(fields: [ageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sex LutAnimalSex? @relation(fields: [sexId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  weightUnit LutWeighUnit? @relation(fields: [weightUnitId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  discoveryState LutDiscoveryState? @relation(fields: [discoveryStateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deathCause LutAnimalDeathCause @relation(fields: [deathCauseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  preservationMethod LutPreservationMethod @relation(fields: [preservationMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  results Result[]
  measures SpecimenMeasure[]
}
model Event {
  @@map("data_evenement")

  id Int @id @default(autoincrement())

  typeId Int @db.SmallInt @map(name: "id_type") @default(0)
  type LutEventType @relation(fields: [typeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  reportOriginId Int @map(name: "id_provenance_signalement")
  reportOrigin LutReportOrigin @relation(fields: [reportOriginId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  programId Int @map(name: "id_programme") @default(10)
  program LutEventProgram @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  statusId Int @db.SmallInt @map(name: "id_statut") @default(2)
  status LutEventStatus @relation(fields: [statusId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  silabId String? @map(name: "id_silab")
  mapaqId String? @map(name: "no_mapaq")
  cqsasIncidentNumber String? @map(name: "no_incident_cqsas")

  // Submission
  submitterId String @map(name: "id_soumissionnaire")
  submitter User @relation("EventSubmitter", fields: [submitterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Discovery
  discoverer Discoverer? 
  isDiscovererSameAsSubmitter Boolean @default(false) @map(name: "decouvreur_idem_soumissionnaire")
  discoveredAt DateTime? @db.Date @map(name: "date_decouverte")

  reportedAt DateTime? @db.Date @map(name: "date_signalement")
  collectedAt DateTime? @db.Date @map(name: "date_recolte")

  closedAt DateTime? @db.Date @map("date_fermeture_dossier")

  hadHumanContact Boolean @default(false) @map(name: "contact_humain")
  hadAnimalContact Boolean @default(false) @map(name: "contact_animal")
 
  collaboratorId Int? @db.SmallInt @map(name: "id_intervenant")
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  habitatTypeId Int? @db.SmallInt @map(name: "id_type_habitat")
  habitatType LutHabitatType? @relation(fields: [habitatTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Lab
  labId Int? @map(name: "id_laboratoire")
  lab LutLaboratory? @relation(fields: [labId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  labResponsible User? @relation("EventLabResponsible", fields: [labResponsibleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  labShippedAt DateTime? @db.Date @map(name: "date_expedition_labo")
  labShippingMethodId Int? @db.SmallInt @map(name: "id_methode_expedition")
  labShippingMethod LutLabShippingMethod? @relation(fields: [labShippingMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  labShippingTrackingNumber String? @map(name: "no_suivi_transporteur")

  // Legacy data_laboratoire
  labReceivedAt DateTime? @db.Date @map(name: "labo_date_reception")
  labReceivedBy String? @map(name: "labo_recu_par")
  labResponsibleId String? @map(name: "labo_id_responsable")

  temperature Decimal? @db.Decimal(4, 1) @map(name: "temperature")
  observations String? @map(name: "observations")
  comments String? @map(name: "commentaires")
  keywords String? @map(name: "motcles")

  pathologyNumber String? @map(name: "numero_pathologie")

