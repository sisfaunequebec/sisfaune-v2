  affectedSpecie5 LutAnimalSpecie? @relation("EventAffectedSpecie5", fields: [affectedSpecie5Id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  affectedSpecie5UnhealtyCount Int? @db.SmallInt @map(name: "affect5_malade")
