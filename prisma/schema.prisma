model LabEvent {
  @@map("data_laboratoire")
  @@id([eventId, labId])

  eventId Int @map(name: "id_evenement")
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  labId Int @map(name: "id_laboratoire")
  lab LutLaboratory @relation(fields: [labId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  receivedAt DateTime? @map(name: "date_reception")
  receivedBy String? @map(name: "recu_par")

  // TODO: 
