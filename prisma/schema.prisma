enum LocationType {
  adresse
  coordonnees
}

model Location {
  @@map("data_localisation")

  eventId Int @id @map(name: "id_evenement")
  description String? @map(name: "description")

  typeId LocationType @default(coordonnees)
  latitude Decimal? @db.Decimal(10,6) @map(name: "latitude")
  longitude Decimal? @db.Decimal(10,6) @map(name: "longitude")

  streetNumber String? @map(name: "no_civique")
  street String? @map(name: "route")
  apt String? @map(name: "appartement")
  intersection String? @map(name: "intersection")

  localityId Int? @map(name: "id_muni")
  localityName String? @map(name: "municipalite")
  province String? @map(name: "province")
  postalCode String? @map(name: "code_postal")

  locality LutLocality? @relation(fields: [localityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum AdminRole {
  soumissionnaire
  gestion
  laboratoire
  consultation
}

model AdminUserProgram {
  @@map("admin_x_utilisateur_programme")

  @@id([userId, programId])
  userId String @map(name: "id_utilisateur")
  programId Int @map(name: "id_programme")
  roleId AdminRole? @map(name: "id_role")
  canSubmit Boolean @map(name: "peut_soumettre") @default(false)

  // Relations
  program LutEventProgram @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model EventAnalysisGroup {
  @@map("x_evenement_groupeanalyse")

  @@id([eventId, analysisGroupId])
  eventId Int @map(name: "id_evenement")
  analysisGroupId Int @map(name: "id_analyse_groupe")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  analysisGroup LutAnalysisGroup @relation(fields: [analysisGroupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum TaskStatus {
  en_cours
  termine
  erreur
}

model Tasks {
  @@map("admin_tache")

  id Int @id @map(name: "id_tache") @default(autoincrement())
  userId String @map(name: "id_utilisateur")
  sessionId String @map(name: "id_session")
  status TaskStatus @default(en_cours) @map(name: "etat") 
  payload Json? @map(name: "parametres") 
  result Json? @map(name: "resultat") 
  wasSeen Boolean @map(name: "vu") @default(false)

  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime? @updatedAt @map(name: "meta_date_maj")
}

