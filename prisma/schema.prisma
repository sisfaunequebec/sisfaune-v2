
generator client {
  provider = "prisma-client-js"
  extensions = [postgis(version: "3.5")]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL") // uses connection pooling
}

model User {
  @@map("auth_utilisateur")

  id String @id @default(dbgenerated("gen_random_uuid()"))

  username String @unique @map(name: "nom_utilisateur")
  password String @unique @map(name: "mot_de_passe")

  email String @unique @map(name: "adresse_courriel")
  emailVerified DateTime? @map(name: "meta_date_verification_courriel")

  isActive Boolean @default(true) @map(name: "est_actif")

  firstName String? @map(name: "prenom")
  lastName String? @map(name: "nom")

  title String? @map(name: "titre")
  organisation String? @map(name: "organisation")
  division String? @map(name: "division")
  service String? @map(name: "service")

  streetNumber String? @map(name: "no_civique")
  street String? @map(name: "route")
  apt String? @map(name: "appartement")

  localityName String? @map(name: "municipalite")
  province String? @map(name: "province")
  postalCode String? @map(name: "code_postal")

  telephone String? @map(name: "telephone")
  extension String? @map(name: "poste")
  mobile String? @map(name: "cellulaire")
  fax String? @map(name: "telecopieur")

  isAdmin Boolean @default(false) @map(name: "est_admin")
  isPathologist Boolean @default(false) @map(name: "est_pathologiste")
  canReopenEvent Boolean @default(false) @map(name: "peut_rouvrir_evenement")

  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")
  
  permissions AdminUserProgram[]

  accounts Account[]
  sessions Session[]

  eventsCreated Event[] @relation("EventCreator")
  eventsSubmitted Event[] @relation("EventSubmitter")

  eventsResponsible Event[] @relation("EventLabResponsible")
}
 
model Account {
  @@map("auth_compte")

  userId            String  @map(name: "id_utilisateur")
  type              String
  provider          String @map(name: "id_fournisseur")
  providerAccountId String  @map(name: "id_compte_fournisseur")
  refresh_token     String? @map(name: "jeton_renouvellement")
  access_token      String? @map(name: "jeton_acces")
  expires_at        Int? @map(name: "meta_date_expiration")
  token_type        String? @map(name: "type_jeton")
  scope             String?
  id_token          String? @map(name: "id_jeton")
  session_state     String? @map(name: "etat_session")

  isActive Boolean @map(name: "actif") @default(true)
 
  createdAt DateTime @default(now())  @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  @@map("auth_session")

  sessionToken String   @unique @map(name: "jeton_session")
  userId       String @map(name: "id_utilisateur")
  expires      DateTime @map(name: "meta_date_expiration")
  createdAt DateTime @default(now()) @map(name: "meta_date_creation")
  updatedAt DateTime @updatedAt @map(name: "meta_date_maj")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
 
model VerificationToken {
  @@map("auth_token")

  identifier String @unique @map(name: "identifiant")
  token      String @unique @map(name: "jeton")
  expires    DateTime @map(name: "meta_date_expiration")
 
  @@id([identifier, token])
}

model LutAnalysisSector {
  @@map("lut_analyse_secteur")

  id Int @db.SmallInt @id
